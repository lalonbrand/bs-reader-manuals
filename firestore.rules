rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailDocId(id) {
      return id is string && id.size() >= 3 && id.size() <= 160 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z0-9]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isRootSuperAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email is string &&
             request.auth.token.email == 'mrlalon@bsreader.local';
    }

    function isSuperAdmin() {
      return isRootSuperAdmin() || (
        isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.token.email))
      );
    }

    function isCoordinator() {
      return isSignedIn() &&
             !isSuperAdmin() &&
             !exists(/databases/$(database)/documents/disabledCoordinators/$(request.auth.uid));
    }

    function canUploadExamBank() {
      return isSuperAdmin() || isCoordinator();
    }

    function isValidBatch(data) {
      return isValidId(data.userId) &&
             data.uploaderName is string && data.uploaderName.size() >= 1 && data.uploaderName.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
             data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 500 &&
             data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 300 &&
             data.mcqCount is int && data.mcqCount >= 0 && data.mcqCount <= 300 &&
             data.fillCount is int && data.fillCount >= 0 && data.fillCount <= 300 &&
             data.descriptiveCount is int && data.descriptiveCount >= 0 && data.descriptiveCount <= 300 &&
             data.visibility == 'EXAM_BANK' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuestion(data) {
      return isValidId(data.userId) &&
             isValidId(data.batchId) &&
             data.batchTitle is string && data.batchTitle.size() >= 1 && data.batchTitle.size() <= 150 &&
             (data.questionType == 'MCQ' || data.questionType == 'FILL_IN_BLANK' || data.questionType == 'DESCRIPTIVE') &&
             data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 5000 &&
             data.prompt is string && data.prompt.size() >= 3 && data.prompt.size() <= 2000 &&
             data.options is list && data.options.size() <= 6 &&
             (data.options.size() == 0 || data.options[0] is string) &&
             data.correctOptionIndex is int && data.correctOptionIndex >= -1 && data.correctOptionIndex <= 5 &&
             (
               data.questionType != 'MCQ' ||
               (
                 data.options.size() >= 2 &&
                 data.correctOptionIndex >= 0 &&
                 data.correctOptionIndex < data.options.size()
               )
             ) &&
             data.correctAnswer is string && data.correctAnswer.size() >= 1 && data.correctAnswer.size() <= 3000 &&
             data.marks is int && data.marks >= 1 && data.marks <= 100 &&
             data.active is bool &&
             data.visibility == 'EXAM_BANK' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubmission(data) {
      return isValidId(data.userId) &&
             data.candidateName is string && data.candidateName.size() >= 2 && data.candidateName.size() <= 100 &&
             data.phase is string && data.phase.size() >= 1 && data.phase.size() <= 100 &&
             data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 150 &&
             (data.obtainedMarks is int || data.obtainedMarks is float) &&
             data.obtainedMarks >= 0 && data.obtainedMarks <= 10000 &&
             data.totalMarks is int && data.totalMarks >= 1 && data.totalMarks <= 10000 &&
             data.obtainedMarks <= data.totalMarks &&
             (data.percentage is int || data.percentage is float) &&
             data.percentage >= 0 && data.percentage <= 100 &&
             data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 500 &&
             data.mcqCorrect is int && data.mcqCorrect >= 0 && data.mcqCorrect <= 500 &&
             data.mcqTotal is int && data.mcqTotal >= 0 && data.mcqTotal <= 500 &&
             data.mcqCorrect <= data.mcqTotal &&
             (data.fillMarks is int || data.fillMarks is float) &&
             data.fillMarks >= 0 && data.fillMarks <= 5000 &&
             data.fillTotalMarks is int && data.fillTotalMarks >= 0 && data.fillTotalMarks <= 5000 &&
             data.fillMarks <= data.fillTotalMarks &&
             (data.descMarks is int || data.descMarks is float) &&
             data.descMarks >= 0 && data.descMarks <= 5000 &&
             data.descTotalMarks is int && data.descTotalMarks >= 0 && data.descTotalMarks <= 5000 &&
             data.descMarks <= data.descTotalMarks &&
             data.status == 'SUBMITTED' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReview(data) {
      return isValidId(data.submissionId) &&
             data.candidateName is string && data.candidateName.size() >= 2 && data.candidateName.size() <= 100 &&
             data.phase is string && data.phase.size() >= 1 && data.phase.size() <= 100 &&
             data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 150 &&
             (data.obtainedMarks is int || data.obtainedMarks is float) &&
             data.obtainedMarks >= 0 && data.obtainedMarks <= 10000 &&
             data.totalMarks is int && data.totalMarks >= 1 && data.totalMarks <= 10000 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /examPdfBatches/{batchId} {
      allow get: if isValidId(batchId) && existing().visibility == 'EXAM_BANK';
      allow list: if existing().visibility == 'EXAM_BANK';

      allow create: if canUploadExamBank() &&
                       isValidId(batchId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'uploaderName', 'title', 'fileName',
                         'pageCount', 'questionCount', 'mcqCount', 'fillCount', 'descriptiveCount',
                         'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'uploaderName', 'title', 'fileName',
                         'pageCount', 'questionCount', 'mcqCount', 'fillCount', 'descriptiveCount',
                         'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidBatch(incoming());

      allow update: if isSuperAdmin() &&
                       isValidId(batchId) &&
                       isValidBatch(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'questionCount', 'mcqCount', 'fillCount', 'descriptiveCount', 'updatedAt']);

      allow delete: if isSuperAdmin() && isValidId(batchId);
    }

    match /examQuestions/{questionId} {
      allow get: if isValidId(questionId) && existing().visibility == 'EXAM_BANK';
      allow list: if existing().visibility == 'EXAM_BANK';

      allow create: if canUploadExamBank() &&
                       isValidId(questionId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'batchId', 'batchTitle', 'questionType', 'orderIndex',
                         'prompt', 'options', 'correctOptionIndex', 'correctAnswer',
                         'marks', 'active', 'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'batchId', 'batchTitle', 'questionType', 'orderIndex',
                         'prompt', 'options', 'correctOptionIndex', 'correctAnswer',
                         'marks', 'active', 'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidQuestion(incoming()) &&
                       (
                         exists(/databases/$(database)/documents/examPdfBatches/$(incoming().batchId)) ||
                         existsAfter(/databases/$(database)/documents/examPdfBatches/$(incoming().batchId))
                       );

      allow update: if isSuperAdmin() &&
                       isValidId(questionId) &&
                       isValidQuestion(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().batchId == existing().batchId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'prompt', 'options', 'correctOptionIndex', 'correctAnswer', 'marks', 'active', 'updatedAt'
                       ]);

      allow delete: if isSuperAdmin() && isValidId(questionId);
    }

    match /examSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && existing().status == 'SUBMITTED';
      allow list: if existing().status == 'SUBMITTED';

      allow create: if isValidId(submissionId) &&
                       incoming().keys().hasAll([
                         'userId', 'candidateName', 'phase', 'factoryName',
                         'obtainedMarks', 'totalMarks', 'percentage', 'questionCount',
                         'mcqCorrect', 'mcqTotal', 'fillMarks', 'fillTotalMarks',
                         'descMarks', 'descTotalMarks', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'candidateName', 'phase', 'factoryName',
                         'obtainedMarks', 'totalMarks', 'percentage', 'questionCount',
                         'mcqCorrect', 'mcqTotal', 'fillMarks', 'fillTotalMarks',
                         'descMarks', 'descTotalMarks', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSubmission(incoming());

      // Terminal state locking: submitted exam results are immutable except by super admin
      allow update: if isSuperAdmin() &&
                       isValidId(submissionId) &&
                       isValidSubmission(incoming()) &&
                       existing().status != 'SUBMITTED';

      allow delete: if isSuperAdmin() && isValidId(submissionId);
    }

    match /disabledCoordinators/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();

      allow create, update: if isSuperAdmin() &&
                               isValidId(uid) &&
                               incoming().keys().hasAll(['uid', 'name', 'blockedByUid', 'createdAt']) &&
                               incoming().keys().hasOnly(['uid', 'name', 'blockedByUid', 'createdAt']) &&
                               incoming().uid == uid &&
                               incoming().name is string &&
                               incoming().name.size() >= 1 &&
                               incoming().name.size() <= 100 &&
                               incoming().blockedByUid == request.auth.uid &&
                               incoming().createdAt is timestamp &&
                               incoming().createdAt <= request.time;

      allow delete: if isSuperAdmin() && isValidId(uid);
    }

    match /superAdmins/{email} {
      allow get: if isSignedIn() && isValidEmailDocId(email) && (
        ('email' in request.auth.token && request.auth.token.email == email) ||
        isSuperAdmin()
      );
      allow list: if isSuperAdmin();

      allow create, update: if isSuperAdmin() &&
                               isValidEmailDocId(email) &&
                               email != 'mrlalon@bsreader.local' &&
                               incoming().keys().hasAll(['email', 'addedByEmail', 'addedByUid', 'createdAt']) &&
                               incoming().keys().hasOnly(['email', 'addedByEmail', 'addedByUid', 'createdAt']) &&
                               incoming().email == email &&
                               incoming().addedByEmail == request.auth.token.email &&
                               incoming().addedByUid == request.auth.uid &&
                               incoming().createdAt is timestamp &&
                               incoming().createdAt <= request.time;

      allow delete: if isSuperAdmin() &&
                       isValidEmailDocId(email) &&
                       email != 'mrlalon@bsreader.local';
    }

    match /users/{userId}/examReviews/{submissionId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(submissionId) && request.auth.uid == userId;
      allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(submissionId) &&
                       request.auth.uid == userId &&
                       incoming().submissionId == submissionId &&
                       incoming().keys().hasAll([
                         'submissionId', 'candidateName', 'phase', 'factoryName',
                         'obtainedMarks', 'totalMarks', 'items', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'submissionId', 'candidateName', 'phase', 'factoryName',
                         'obtainedMarks', 'totalMarks', 'items', 'createdAt'
                       ]) &&
                       isValidReview(incoming()) &&
                       (
                         exists(/databases/$(database)/documents/examSubmissions/$(submissionId)) ||
                         existsAfter(/databases/$(database)/documents/examSubmissions/$(submissionId))
                       );

      allow update: if false;

      allow delete: if isSignedIn() && isValidId(userId) && isValidId(submissionId) && (
        request.auth.uid == userId || isSuperAdmin()
      );
    }
  }
}
